# DEBUG MODE
DEBUG=false

#LANG
APP_LANG='en'

#FULLSCREEN LOAD APP
FULLSCREEN_ON_LOAD='1'
WIDTH=1200
HEIGH=800

# Force_mode
NAME_MODE='Current'

# UART PORTS
UART_PORT0=/dev/ttyAMA3
UART_PORT1=/dev/ttyAMA4
UART_PORT2=/dev/ttyAMA5

# PINS
PIN_INPUT_MEN=10
PIN_INPUT_WOMEN=6
PIN_BUTTON=27
PIN_BUTTON_2=17

# PATHS
DB_PATH=./vacantview/data/app_data.db
IMG_DIR =./assets/images/Background
LOGO_DIR =./assets/images/Logo
LOGO_ACCESSIBLE=logo_accessible_2.png
LOGO_COMPANY=Stern logo_Black.png

# PATH TO CONFIG VIEWES
MAN_CNF=./vacantview/config/man.json
WOMAN_CNF=./vacantview/config/woman.json
BOTH_CNF=./vacantview/config/family.json
CUSTOM_CNF=./vacantview/config/custom.json
MAN_A_CNF=./vacantview/config/man_with_accessible.json
WOMAN_A_CNF=./vacantview/config/woman_with_accessible.json
BOTH_A_CNF=./vacantview/config/family_with_accessible.json

# PIR MOTION SENSOR + AUDIO ANNOUNCER
PIN_PIR=23
AUDIO_VACANT=./vacantview/assets/audio/vacant.wav
AUDIO_OCCUPIED=./vacantview/assets/audio/occupied.wav
AUDIO_COOLDOWN=10
# AUDIO_DEVICE=default                    (USB speaker - single)
# AUDIO_DEVICE=plughw:0,0                 (I2S MAX98357A)
# AUDIO_DEVICE=plughw:2,0,plughw:0,0     (USB + I2S במקביל)

